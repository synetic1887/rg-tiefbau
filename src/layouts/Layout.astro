---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { company, social } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const SITE_ORIGIN = "https://www.rg-tiefbau.com";

const {
  title = `${company.name} | Bauunternehmen aus Butzbach`,
  description = "Familiengeführtes Bauunternehmen aus Butzbach: Erdbau, Tiefbau, Grundleitungen, Rohbau, Stahlbetonbau und Schlüsselfertigbau.",
  image = "/brand/og-card-2026.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_ORIGIN).href;
const absoluteImage = image.startsWith("http")
  ? image
  : new URL(image, Astro.site ?? SITE_ORIGIN).href;
const logoAbsolute = new URL("/brand/logo.png", Astro.site ?? SITE_ORIGIN).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/icon.png" />
    <link rel="apple-touch-icon" href="/brand/icon@2x.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ef7c00" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={`${company.name} – Manuel Geis und Ulrich Rudolf beim Spatenstich`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Organization / WebSite / SiteNavigation für Google Sitelinks und Logo -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["Organization", "GeneralContractor"],
            "@id": "https://www.rg-tiefbau.com/#organization",
            name: company.name,
            alternateName: ["RG Tiefbau", "RG Hochbau und Tiefbau", "RG Hoch-&Tiefbau"],
            legalName: company.legalName,
            description,
            url: "https://www.rg-tiefbau.com",
            logo: {
              "@type": "ImageObject",
              "@id": "https://www.rg-tiefbau.com/#logo",
              url: logoAbsolute,
              contentUrl: logoAbsolute,
              caption: company.name,
              width: 1698,
              height: 730,
            },
            image: { "@id": "https://www.rg-tiefbau.com/#logo" },
            telephone: company.phone,
            email: company.email,
            foundingDate: "2026",
            founder: { "@type": "Person", name: company.managingDirector },
            address: [
              {
                "@type": "PostalAddress",
                streetAddress: company.street,
                postalCode: company.zip,
                addressLocality: company.city,
                addressRegion: "Hessen",
                addressCountry: "DE",
              },
              {
                "@type": "PostalAddress",
                streetAddress: "Pleistermühlenweg 278",
                postalCode: "48157",
                addressLocality: "Münster",
                addressRegion: "Nordrhein-Westfalen",
                addressCountry: "DE",
              },
            ],
            areaServed: { "@type": "Country", name: "Deutschland" },
            sameAs: [social.instagram],
            knowsAbout: [
              "Erdbau",
              "Tiefbau",
              "Rohbau",
              "Hochbau",
              "Stahlbetonbau",
              "Grundleitungen",
              "Nahwärme",
              "Schlüsselfertigbau",
            ],
          },
          {
            "@type": "WebSite",
            "@id": "https://www.rg-tiefbau.com/#website",
            url: "https://www.rg-tiefbau.com",
            name: company.name,
            description,
            publisher: { "@id": "https://www.rg-tiefbau.com/#organization" },
            inLanguage: "de-DE",
          },
          {
            "@type": "SiteNavigationElement",
            "@id": "https://www.rg-tiefbau.com/#sitenav",
            name: ["Start", "Leistungen", "Projekte", "Aktuelles", "Über uns", "Karriere", "Kontakt"],
            url: [
              "https://www.rg-tiefbau.com/",
              "https://www.rg-tiefbau.com/leistungen/",
              "https://www.rg-tiefbau.com/projekte/",
              "https://www.rg-tiefbau.com/aktuelles/",
              "https://www.rg-tiefbau.com/ueber-uns/",
              "https://www.rg-tiefbau.com/karriere/",
              "https://www.rg-tiefbau.com/kontakt/",
            ],
          },
        ],
      })}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >Zum Inhalt springen</a
    >
    <div id="scroll-progress"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll progress bar
      const bar = document.getElementById("scroll-progress");
      const onScrollProgress = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        const p = max > 0 ? h.scrollTop / max : 0;
        if (bar) bar.style.transform = `scaleX(${p})`;
      };
      window.addEventListener("scroll", onScrollProgress, { passive: true });
      onScrollProgress();
    </script>

    <script>
      // Reveal-on-scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
