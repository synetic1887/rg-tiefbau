---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { services, projects } from "../data/site";

const refs: Record<string, string> = {
  erdarbeiten: "grant-immobilien-muenster-erdbau",
  grundleitungen: "rs-immo-duesseldorf-wohnanlage",
  rohbau: "koenigstein-umbau-aufstockung",
  schluesselfertigbau: "alsfeld-lagerhalle-erweiterung",
  stahlbetonbau: "rewe-erweiterung",
  industriebau: "bitterfeld-antennenfeld-gruendung",
};
const refOf = (slug: string) => projects.find((p) => p.slug === refs[slug]);

---

<Layout
  title="Leistungen | RG Hoch-&Tiefbau GmbH"
  description="Erdbau und Tiefbau, Grundleitungen und Nahwärme, Rohbau, Stahlbetonbau, Schlüsselfertigbau und Industriebau – mit Beispielen aus unseren Projekten."
>
  <PageHero
    title="Sechs Gewerke. Ein Ansprechpartner."
    subtitle="Was wir selbst ausführen – jeweils mit einem Beispiel aus unseren Projekten."
    crumbs={[
      { label: "Start", href: "/" },
      { label: "Leistungen", href: "/leistungen" },
    ]}
  />

  <!-- Detailed services -->
  <div class="container-rg divide-y divide-line py-12 md:py-16">
    {
      services.map((s) => {
        const ref = refOf(s.slug);
        return (
          <article id={s.slug} class="reveal grid scroll-mt-28 gap-8 py-12 md:py-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
            <div>
              <h2 class="text-2xl font-800 md:text-3xl">{s.title}</h2>
              <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{s.description}</p>
              <p class="mt-5 max-w-2xl leading-relaxed text-anthracite">
                <span class="font-700">Dazu gehört:</span> {s.bullets.join(", ")}.
              </p>
            </div>
            {ref && (
              <a href={`/projekte#${ref.slug}`} class="group block">
                <figure class="overflow-hidden rounded-2xl">
                  <img
                    src={ref.image}
                    alt={ref.title}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </figure>
                <p class="mt-3 text-sm text-muted">
                  Beispiel: <span class="font-600 text-ink group-hover:text-brand-dark">{ref.title}</span>
                </p>
              </a>
            )}
          </article>
        );
      })
    }
  </div>

  <div class="py-20 md:py-24">
    <CtaBand title="Welche Leistung brauchen Sie?" />
  </div>
</Layout>
