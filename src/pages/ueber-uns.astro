---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Stats from "../components/Stats.astro";
import CtaBand from "../components/CtaBand.astro";
import BrandPanel from "../components/BrandPanel.astro";
import { company } from "../data/site";

const values = [
  { icon: "handshake", title: "Verlässlichkeit", text: "Ein Wort, ein Handschlag. Was wir zusagen, halten wir. Termintreu und ohne Ausreden." },
  { icon: "shield", title: "Sorgfalt", text: "Sauber nach Plan und Norm gebaut. Wir bauen jedes Projekt, als wäre es unser eigenes." },
  { icon: "euro", title: "Klare Preise", text: "Angebote, die man nachvollziehen kann. Änderungen besprechen wir, bevor sie Geld kosten." },
  { icon: "compass", title: "Kurze Wege", text: "Sitz in Butzbach, Niederlassung in Münster. Wenn es brennt, sind wir schnell vor Ort." },
];
---

<Layout
  title="Über uns | RG Hoch-&Tiefbau GmbH"
  description="RG Hoch-&Tiefbau GmbH aus Butzbach. Ein neu gegründetes Unternehmen, geführt von einer Geschäftsführung mit über 35 Jahren Branchenerfahrung."
>
  <PageHero
    eyebrow="Über uns"
    title="Neu am Markt. Nicht neu im Geschäft."
    subtitle="Ein junges Unternehmen aus Butzbach – gegründet von zwei Leuten, die zusammen seit über 35 Jahren auf dem Bau zu Hause sind."
    crumbs={[
      { label: "Start", href: "/" },
      { label: "Über uns", href: "/ueber-uns" },
    ]}
  />

  <!-- Story -->
  <section class="container-rg py-20 md:py-28">
    <div class="grid items-center gap-14 lg:grid-cols-2">
      <div class="reveal relative">
        <BrandPanel
          ratio="aspect-[4/5]"
          photo="/brand/gruender.jpg"
          photoAlt="Manuel Geis und Ulrich Rudolf in RG-Warnwesten auf der Baustelle"
          photoPosition="center 30%"
          label="Manuel Geis & Ulrich Rudolf"
          sublabel="Gründer von RG"
          pinIcon="building"
          class="shadow-[0_30px_60px_-35px_rgba(28,28,27,0.5)]"
        />
        <div class="absolute -right-4 -top-5 hidden rounded-2xl bg-white p-5 shadow-xl ring-1 ring-line sm:block">
          <p class="font-display text-sm font-700 text-graphite">Gegründet in</p>
          <p class="font-display text-3xl font-900 text-brand">{company.city}</p>
        </div>
      </div>

      <div class="reveal">
        <p class="eyebrow">Unsere Geschichte</p>
        <h2 class="section-title mt-4">Erfahrung, die man spürt.</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Die {company.name} ist ein junges Unternehmen mit Sitz in {company.city}.
          Hinter RG stehen Ulrich Rudolf und Manuel Geis – das R und das G. Zusammen
          bringen sie über {company.experience} Jahre Erfahrung auf dem Bau mit.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Diese Erfahrung ist unser Fundament. Wir wissen, worauf es auf der Baustelle
          ankommt: saubere Planung, ehrliche Kommunikation und ein Ergebnis, das hält.
          Vom kleinen Erdaushub bis zum schlüsselfertigen Hochbau. Wir packen an.
        </p>
        <div class="mt-8 flex items-center gap-4 rounded-2xl border border-line bg-sand p-5">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand text-white">
            <Icon name="check" class="h-6 w-6" />
          </span>
          <p class="font-600 text-anthracite">
            Geschäftsführer <span class="text-brand-dark">{company.managingDirector}</span>.
            Ihr direkter Ansprechpartner von der Anfrage bis zur Übergabe.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-cloud py-20 md:py-28">
    <div class="container-rg">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="section-title">Was Sie von uns erwarten können</h2>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <div class="reveal rounded-2xl bg-white p-7 text-center">
              <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-soft text-brand-dark">
                <Icon name={v.icon} class="h-7 w-7" stroke={1.5} />
              </span>
              <h3 class="mt-5 text-lg font-700">{v.title}</h3>
              <p class="mt-2.5 text-[0.96rem] leading-relaxed text-muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Stats />

  <!-- Team photo -->
  <section class="container-rg py-20 md:py-28">
    <figure class="reveal overflow-hidden rounded-3xl shadow-[0_30px_70px_-45px_rgba(28,28,27,0.5)]">
      <img
        src="/brand/team-spatenstich.jpg"
        alt="Manuel Geis und Ulrich Rudolf mit Partnern beim Spatenstich vor Bagger und Raupe"
        loading="lazy"
        decoding="async"
        class="aspect-[3/2] w-full object-cover"
      />
    </figure>
    <p class="mt-4 text-center text-sm text-muted">Spatenstich mit Partnern – Manuel Geis (2. v. l.) und Ulrich Rudolf (3. v. l.)</p>
  </section>

  <div class="pb-20 md:pb-24">
    <CtaBand title="Lernen Sie uns kennen" />
  </div>
</Layout>
