---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Stats from "../components/Stats.astro";
import CtaBand from "../components/CtaBand.astro";
import BrandPanel from "../components/BrandPanel.astro";
import NewsCard from "../components/NewsCard.astro";
import InstagramTeaser from "../components/InstagramTeaser.astro";
import { services, advantages, projects, partners, memberships, company } from "../data/site";

const latestNews = (await getCollection("news"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const trust = [
  { icon: "map-pin", label: "Butzbach und Münster" },
  { icon: "excavator", label: "Eigener Maschinenpark" },
  { icon: "phone", label: "Inhaber direkt erreichbar" },
];
const featured = projects[0];
---

<Layout>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden bg-sand">
    <div
      class="pointer-events-none absolute inset-0 opacity-60"
      style="background-image:linear-gradient(to right,rgba(28,28,27,0.035) 1px,transparent 1px),linear-gradient(to bottom,rgba(28,28,27,0.035) 1px,transparent 1px);background-size:52px 52px;"
    >
    </div>
    <div class="pointer-events-none absolute -right-32 -top-20 h-[30rem] w-[30rem] rounded-full bg-brand/12 blur-3xl"></div>

    <div class="container-rg relative grid items-center gap-14 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
      <!-- Left -->
      <div data-stagger>
        <p class="eyebrow">Hochbau &amp; Tiefbau aus {company.city}</p>
        <h1 class="mt-5 text-[2.6rem] font-900 leading-[1.02] sm:text-6xl lg:text-[4.1rem]">
          Ein Wort.<br />
          <span class="text-brand">Ein Handschlag.</span>
        </h1>
        <p class="mt-6 max-w-xl text-2xl font-800 leading-snug text-ink">Wir bauen jedes Projekt, als wäre es unser eigenes.</p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
          Erdbau, Tiefbau, Grundleitungen, Rohbau, Stahlbetonbau und schlüsselfertiges
          Bauen. Aus {company.city}, mit Niederlassung in Münster. Geführt von zwei Leuten,
          die zusammen über {company.experience} Jahre auf dem Bau stehen.
        </p>
        <div class="mt-9 flex flex-col gap-3.5 sm:flex-row">
          <a href="/kontakt" class="btn btn-primary !px-7 !py-3.5 text-base">
            Projekt anfragen
            <Icon name="arrow-right" class="h-5 w-5" />
          </a>
          <a href="/leistungen" class="btn btn-ghost !px-7 !py-3.5 text-base">
            Unsere Leistungen
          </a>
        </div>

        <!-- trust row -->
        <div class="mt-11 flex flex-wrap gap-x-7 gap-y-3">
          {
            trust.map((t) => (
              <div class="flex items-center gap-2.5 text-[0.95rem] font-600 text-graphite">
                <Icon name={t.icon} class="h-5 w-5 text-brand" />
                {t.label}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right: branded panel + floating badges -->
      <div class="reveal relative">
        <BrandPanel
          class="shadow-[0_40px_80px_-40px_rgba(28,28,27,0.5)]"
          ratio="aspect-[16/11]"
          photo="/brand/team-spatenstich.jpg"
          photoAlt="Manuel Geis und Ulrich Rudolf mit Partnern beim Spatenstich vor Bagger und Raupe"
          photoPosition="center 35%"
          label="Spatenstich"
          sublabel="Manuel Geis & Ulrich Rudolf"
          pinIcon="excavator"
        />

        <!-- floating experience badge -->
        <div class="absolute -left-4 -top-5 hidden rounded-2xl bg-white p-4 shadow-xl ring-1 ring-line sm:block">
          <div class="flex items-center gap-3">
            <span class="font-display text-4xl font-900 text-brand">35<span class="text-2xl">+</span></span>
            <span class="text-sm font-600 leading-tight text-graphite">Jahre<br />Erfahrung</span>
          </div>
        </div>
        <!-- floating one-hand badge -->
        <div class="absolute -bottom-5 -right-3 hidden rounded-2xl bg-brand px-5 py-4 text-white shadow-xl md:block">
          <p class="font-display text-sm font-800">Ein Ansprechpartner</p>
          <p class="text-xs text-white/80">vom Aushub bis zur Übergabe</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= LEISTUNGEN ================= -->
  <section class="container-rg py-20 md:py-28">
    <div class="reveal flex flex-col items-end justify-between gap-6 md:flex-row">
      <div class="max-w-2xl">
        <h2 class="section-title">Was wir bauen</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Von Erdbau und Tiefbau über Grundleitungen und Nahwärme bis zu Rohbau,
          Stahlbetonbau und Schlüsselfertigbau. Ein Ansprechpartner für Ihr gesamtes
          Projekt.
        </p>
      </div>
      <a href="/leistungen" class="link-arrow shrink-0">
        Alle Leistungen
        <Icon name="arrow-right" class="h-4.5 w-4.5" />
      </a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <div class="reveal h-full">
            <ServiceCard service={s} href={`/leistungen#${s.slug}`} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= ÜBER UNS TEASER ================= -->
  <section class="bg-cloud py-20 md:py-28">
    <div class="container-rg grid items-center gap-14 lg:grid-cols-2">
      <div class="reveal relative order-2 lg:order-1">
        <BrandPanel
          ratio="aspect-[5/4]"
          photo="/brand/gruender-2.jpg"
          photoAlt="Manuel Geis und Ulrich Rudolf auf der Baustelle"
          photoPosition="center 30%"
          class="shadow-[0_30px_60px_-35px_rgba(28,28,27,0.4)]"
        />
        <div class="absolute -bottom-6 left-6 rounded-2xl bg-brand px-6 py-5 text-white shadow-lg">
          <p class="font-display text-2xl font-900 leading-none">Ulrich Rudolf &amp; Manuel Geis</p>
          <p class="mt-1 text-sm text-white/85">Die Gründer – das R und das G in RG</p>
        </div>
      </div>

      <div class="reveal order-1 lg:order-2">
        <p class="eyebrow">Über RG</p>
        <h2 class="section-title mt-4">Frisch gegründet.<br />Erfahren geführt.</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          RG steht für Rudolf und Geis. Das Unternehmen ist jung, die Leute dahinter
          sind es nicht: Zusammen bringen Ulrich Rudolf und Manuel Geis über
          {company.experience} Jahre Erfahrung auf dem Bau mit.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Bei uns sprechen Sie direkt mit den Inhabern. Kurze Wege, klare Absprachen –
          und was wir zusagen, halten wir.
        </p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          {
            [
              "Inhaber auf der Baustelle",
              "Angebote mit klaren Positionen",
              "Eigener Maschinenpark",
              "Sitz in Butzbach, Niederlassung Münster",
            ].map((t) => (
              <li class="flex items-center gap-3 font-600 text-anthracite">
                <Icon name="check-circle" class="h-5.5 w-5.5 shrink-0 text-brand" />
                {t}
              </li>
            ))
          }
        </ul>
        <a href="/ueber-uns" class="btn btn-dark mt-9 !px-7 !py-3.5">
          Mehr über uns
          <Icon name="arrow-right" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- ================= IMAGEFILM ================= -->
  <section class="bg-ink py-20 md:py-28">
    <div class="container-rg">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="section-title text-white">Wir bauen. Sehen Sie selbst.</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/70">
          Ein Blick auf unsere Baustellen und darauf, wie wir arbeiten.
        </p>
      </div>

      <div class="reveal mx-auto mt-12 max-w-4xl">
        <div
          class="relative aspect-video overflow-hidden rounded-3xl shadow-[0_40px_80px_-40px_rgba(0,0,0,0.7)] ring-1 ring-white/10"
          data-yt-embed
          data-video-id="82Iscjjclrs"
        >
          <button
            type="button"
            data-yt-play
            aria-label="Imagefilm abspielen (öffnet YouTube)"
            class="group absolute inset-0 h-full w-full cursor-pointer"
          >
            <img
              src="/imagefilm/poster.jpg"
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div
              class="absolute inset-0"
              style="background:linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.35) 50%, rgba(0,0,0,0.65) 100%);"
            ></div>
            <span
              class="absolute left-1/2 top-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-brand text-white shadow-[0_12px_40px_-10px_rgba(239,124,0,0.75)] transition-transform duration-300 group-hover:scale-110 md:h-24 md:w-24"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-9 w-9 md:h-11 md:w-11" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </span>
          </button>
        </div>
        <p class="mt-4 text-center text-sm text-white/50">
          Beim Klick werden Daten an YouTube (Google Ireland Ltd.) übertragen.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <Stats />

  <!-- ================= WARUM WIR ================= -->
  <section class="container-rg py-20 md:py-28">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="section-title">So arbeiten wir</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Neu am Markt, aber nicht neu auf dem Bau.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        advantages.map((a) => (
          <div class="reveal group relative overflow-hidden rounded-2xl border border-line bg-white p-7 transition-all hover:border-brand-tint hover:shadow-[0_20px_45px_-25px_rgba(28,28,27,0.4)]">
            <span class="font-mono text-4xl font-600 text-brand-tint transition-colors group-hover:text-brand">
              {a.no}
            </span>
            <h3 class="mt-4 text-lg font-700">{a.title}</h3>
            <p class="mt-2.5 text-[0.97rem] leading-relaxed text-muted">{a.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= PARTNER ================= -->
  <section class="container-rg py-20 md:py-28">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="section-title">Unsere Partner</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Für Elektro, Schalung, Gerüst und Lohnleistungen arbeiten wir mit festen Partnern,
        die wir kennen und auf die wir uns verlassen.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        partners.map((p) => (
          <article class="reveal flex h-full flex-col rounded-2xl border border-line bg-white p-7 transition-all hover:border-brand-tint hover:shadow-[0_20px_45px_-25px_rgba(28,28,27,0.4)]">
            <div
              class:list={[
                "flex h-28 items-center justify-center rounded-xl p-5",
                p.logoBg === "dark" ? "bg-ink" : "bg-white",
              ]}
              style={p.logoBgColor ? `background-color:${p.logoBgColor};` : ""}
            >
              <img
                src={p.logo}
                alt={p.name}
                loading="lazy"
                class="max-h-full max-w-full object-contain"
              />
            </div>
            <div class="mt-6">
              <p class="text-sm font-700 uppercase tracking-wider text-brand">{p.trade}</p>
              <h3 class="mt-2 text-xl font-800 text-ink">{p.name}</h3>
              <p class="mt-3 leading-relaxed text-muted">{p.description}</p>
            </div>

            {(p.street || p.phone) && (
              <ul class="mt-6 space-y-2.5 text-[0.96rem]">
                {p.street && (
                  <li class="flex items-start gap-3">
                    <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
                    <span class="text-graphite">{p.street}, {p.zip} {p.city}</span>
                  </li>
                )}
                {p.phone && (
                  <li class="flex items-center gap-3">
                    <Icon name="phone" class="h-5 w-5 shrink-0 text-brand" />
                    <a href={`tel:${p.phoneHref}`} class="text-graphite transition-colors hover:text-brand-dark">
                      {p.phone}
                    </a>
                  </li>
                )}
              </ul>
            )}

            {p.website && (
              <a
                href={p.website}
                target="_blank"
                rel="noopener"
                class="link-arrow mt-auto pt-6 self-start text-[0.95rem]"
              >
                {p.websiteLabel} besuchen
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            )}
          </article>
        ))
      }
    </div>

    <!-- Verbandsmitgliedschaften -->
    <div class="reveal mt-16 border-t border-line pt-14 md:mt-20 md:pt-16">
      <div class="mx-auto max-w-2xl text-center">
        <h3 class="text-2xl font-800 md:text-3xl">Mitglied in</h3>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl grid-cols-2 items-stretch gap-6 lg:grid-cols-4">
        {
          memberships.map((m) => (
            <div class="flex items-center justify-center rounded-2xl bg-white p-8 ring-1 ring-line transition-all hover:-translate-y-1 hover:ring-brand-tint hover:shadow-[0_18px_40px_-25px_rgba(28,28,27,0.35)]">
              <img src={m.logo} alt={m.name} loading="lazy" class="max-h-20 max-w-[85%] object-contain" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    latestNews.length > 0 && (
      <section class="bg-cloud py-20 md:py-28">
        <div class="container-rg">
          <div class="reveal flex flex-col items-end justify-between gap-6 md:flex-row">
            <div class="max-w-2xl">
              <h2 class="section-title">Frisch aus dem Bautagebuch</h2>
              <p class="mt-4 text-lg leading-relaxed text-muted">
                Was bei uns gerade auf der Baustelle passiert. Aktuelle Einblicke,
                neue Projekte und Referenzen.
              </p>
            </div>
            <a href="/aktuelles" class="link-arrow shrink-0">
              Alle Beiträge
              <Icon name="arrow-right" class="h-4.5 w-4.5" />
            </a>
          </div>

          <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
            {latestNews.map((p) => (
              <div class="reveal h-full">
                <NewsCard post={p} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= INSTAGRAM ================= -->
  <InstagramTeaser />

  <!-- ================= REFERENZ ================= -->
  <section class="bg-cloud py-20 md:py-28">
    <div class="container-rg">
      <div class="reveal grid items-stretch gap-0 overflow-hidden rounded-3xl bg-white shadow-[0_30px_70px_-45px_rgba(28,28,27,0.5)] lg:grid-cols-2">
        <div class="relative min-h-[20rem]">
          <BrandPanel
            class="absolute inset-0 h-full w-full !rounded-none"
            ratio=""
            photo={featured.image}
            photoAlt={featured.title}
            status={featured.status}
            label={featured.location}
            sublabel={featured.client}
            pinIcon="pipe"
          />
        </div>
        <div class="flex flex-col justify-center p-8 md:p-12">
          <p class="eyebrow">Referenz</p>
          <h2 class="mt-4 text-3xl font-800 leading-tight md:text-[2.4rem]">{featured.title}</h2>
          <p class="mt-2 font-600 text-graphite">Auftraggeber: {featured.client}</p>
          <p class="mt-5 leading-relaxed text-muted">{featured.summary} {featured.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              featured.tags.map((tag) => (
                <span class="rounded-full bg-brand-soft px-3.5 py-1.5 text-sm font-600 text-brand-dark">
                  {tag}
                </span>
              ))
            }
          </div>
          <a href="/projekte" class="btn btn-ghost mt-9 self-start !px-6 !py-3">
            Alle Projekte ansehen
            <Icon name="arrow-right" class="h-5 w-5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <div class="py-20 md:py-24">
    <CtaBand />
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-yt-embed]").forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>("[data-yt-play]");
    const id = box.dataset.videoId;
    if (!btn || !id) return;
    btn.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = "Imagefilm RG Hoch-&Tiefbau GmbH";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full border-0";
      box.replaceChildren(iframe);
    });
  });
</script>
